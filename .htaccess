# ── dreyburn.com ────────────────────────────────────────────────────────
# Hostinger (Apache/LiteSpeed) behind Cloudflare. This is the only server
# configuration the site has; deploy is otherwise a file copy.

# 404.html at the root is NOT used unless it is named here. Without this
# line a missing page gets the host's default error document.
ErrorDocument 404 /404.html

# The repository is published to be inspected, but a directory listing is
# not a page — it leaks structure and renders none of the system.
Options -Indexes

# No HTTPS rewrite. Cloudflare terminates TLS and the origin sees plain
# HTTP; a RewriteRule forcing https here would see its own redirect come
# back as HTTP forever. Cloudflare sends upgrade-insecure-requests, and
# the redirect belongs in its dashboard, not in this file.

<IfModule mod_headers.c>
  # HTML is re-read on every deploy. Cloudflare already treats it as
  # DYNAMIC; this says so at the origin too, so the two agree.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Fonts are content-addressed by filename — a different weight is a
  # different file, and none of them are ever edited in place.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # CSS and JS are busted by ?v=, not by filename, so they cannot be
  # immutable. A week is long enough to be worth caching and short enough
  # that a missed version bump self-heals instead of persisting.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  <FilesMatch "\.(png|jpg|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml image/svg+xml
</IfModule>

# woff2 predates some stock mime.types files. Serving it as
# application/octet-stream makes the browser download it instead of
# using it, and every page silently falls back to system fonts.
AddType font/woff2 .woff2
